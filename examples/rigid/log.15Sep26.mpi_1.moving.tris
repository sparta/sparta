surf_modify         all collide 1

create_particles    air n 0
Created 48231 particles
  CPU time = 0.0072701 secs
fix		    in emit/face air xhi twopass

timestep 	    0.0001

compute      c1 surf body1 all fx fy fz tx ty tz com 3.0 3.0 0
compute      c2 surf body2 all fx fy fz tx ty tz com 5.0 6.5 0
compute      c3 surf body3 all fx fy fz tx ty tz com 7.2 3.5 0

# grid cell flow volumes, for visualizing cut/split cells

compute      vg property/grid all vol

global              rigid yes

# moi of a uniform triangular plate, edge A: izz = M A^2 / 12

fix	 1 rigid body1 c1 body mass 2.0e-24 com 3.0 3.0 0 vcom 25 10 0          moi 2.27e-25 2.27e-25 4.54e-25 0 0 0 angmom 0 0 6.8e-24          push 1.0e-18 0.1 pushstyle hertz pushdamp 1.5e-22          pushbound yes remap incremental
fix	 2 rigid body2 c2 body mass 2.0e-24 com 5.0 6.5 0 vcom 5 -20 0          moi 2.27e-25 2.27e-25 4.54e-25 0 0 0 angmom 0 0 -5.4e-24          push 1.0e-18 0.1 pushstyle hertz pushdamp 1.5e-22          pushbound yes remap incremental
fix	 3 rigid body3 c3 body mass 2.0e-24 com 7.2 3.5 0 vcom -25 8 0          moi 2.27e-25 2.27e-25 4.54e-25 0 0 0 angmom 0 0 8.2e-24          push 1.0e-18 0.1 pushstyle hertz pushdamp 1.5e-22          pushbound yes remap incremental

