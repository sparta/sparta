################################################################################
# three mobile rigid-body equilateral triangles in an opposing cold beam
# cells are ~3/4 of a triangle edge: spinning triangles exercise the
# cut/split cell machinery in remap incremental mode
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
