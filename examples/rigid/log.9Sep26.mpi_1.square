################################################################################
# 2d flow around a mobile rigid-body square
#
# a square particulate is embedded in a free-stream flow
# particle collisions push it downstream and it responds as a rigid body
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
#  - The "twopass" option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

seed	    	    12345
dimension   	    2
global              gridcut 0.0 comm/sort yes

boundary	    o r p

create_box  	    0 10 0 10 -0.5 0.5
Created orthogonal box = (0 0 -0.5) to (10 10 0.5)
create_grid 	    10 10 1
Created 100 child grid cells
  CPU time = 0.000782087 secs
  create/ghost percent = 92.0389 7.96113
balance_grid        rcb cell
Balance grid migrated 0 cells
  CPU time = 9.7532e-05 secs
  reassign/sort/migrate/ghost percent = 78.9823 0.615183 11.2517 9.15084

global		    nrho 1.0 fnum 0.001

species		    air.species N O
mixture		    air N O vstream 100.0 0 0

# unit square centered at (5,5), treated as a mobile rigid body

read_surf           data.square group square
  4 lines
  4.5 5.5 xlo xhi
  4.5 5.5 ylo yhi
  0 0 zlo zhi
  1 min line length
  4 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  96 0 4 = cells outside/inside/overlapping surfs
  4 = surf cells with 1,2,etc splits
  99 99 = cell-wise and global flow volume
  CPU time = 0.000278169 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 6.50648 24.5656 0.793762 64.1836 3.95048 4.40703 0.0449367
  surf2grid time = 0.000178539 secs
  map/comm1/comm2/comm3/comm4/split percent = 40.7368 6.23729 7.43647 4.48529 32.5839 4.67629

surf_collide	    1 diffuse 300.0 0.0
surf_modify         all collide 1

collide             vss air air.vss

fix		    in emit/face air xlo twopass

timestep 	    0.0001

# per-surf force/torque tallies used to move the rigid body
# moi of a uniform square of edge A: izz = 1/6 M A^2, ixx = iyy = izz/2

compute             csurf surf square all fx fy fz tx ty tz com 5 5 0

global              rigid yes

fix		    1 rigid square csurf body                     mass 5.0e-22 com 5 5 0 vcom 0 0 0                     moi 4.1666667e-23 4.1666667e-23 8.3333333e-23 0 0 0                     angmom 0 0 0

#dump                2 image all 100 image.*.ppm type type pdiam 0.1 #                    surf proc 0.01 size 512 512 zoom 1.75 #                    gline yes 0.005
#dump_modify	    2 pad 4

stats		    100
stats_style	    step cpu np nscoll f_1[1] f_1[2] f_1[4] f_1[5] f_1[15]
run 		    1000
