  CPU time = 0.00125364 secs
  create/ghost percent = 94.7495 5.25048
balance_grid        rcb cell
Balance grid migrated 105 cells
  CPU time = 0.000544402 secs
  reassign/sort/migrate/ghost percent = 58.0352 0.336149 11.6431 29.9856

global		    nrho 1e10 fnum 1e6

species		    air.species N O
mixture		    air N O vstream 0 1000 -1000

mixture             air N frac 0.8
mixture             air O frac 0.2

surf_collide        1 specular
bound_modify        zlo collide 1

region              circle cylinder z 0 -10 1 INF INF
fix                 in emit/face/file air zhi data.beam beam_area nevery 100 region circle twopass

#dump                2 image all 10 image.*.ppm type type pdiam 0.2 surf proc 0.01 size 512 512 zoom 1.75 gline no 0.005
#dump_modify	    2 pad 4

timestep            0.0001

stats		    100
stats_style	    step cpu np nattempt ncoll nscoll nscheck
run 		    1000
