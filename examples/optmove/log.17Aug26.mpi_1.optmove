SPARTA (24 Sep 2025)
Running on 1 MPI task(s)
################################################################################
# 3d collisional flow in a box with periodic and specular boundaries
#
# Exercises the optimized move on the boundary conditions it applies itself:
# a periodic face is a translation and a specular face is a mirror, so a
# particle ending the timestep outside the box is kept on the fast path
# instead of being handed to the normal move.
#
# Run the same script with "-var opt no" to compare against the normal move.
# On a single processor the two agree exactly, step for step.
#
# Note:
#  - The "comm/sort" option to the "global" command is used to match MPI runs.
################################################################################

variable            opt index yes

seed	    	    12345
dimension   	    3
global              gridcut 0.0 comm/sort yes optmove ${opt}
global              gridcut 0.0 comm/sort yes optmove yes

boundary	    p r r

create_box  	    0 0.001 0 0.001 0 0.001
Created orthogonal box = (0 0 0) to (0.001 0.001 0.001)
create_grid 	    10 10 10
Created 1000 child grid cells
  CPU time = 34.4751 secs
  create/ghost percent = 0.00218327 99.9978
balance_grid        rcb part
Balance grid migrated 0 cells
  CPU time = 0.000278373 secs
  reassign/sort/migrate/ghost percent = 61.4647 0.452271 8.5195 29.5636

species		    ar.species Ar
mixture		    air Ar vstream 200.0 100.0 -150.0 temp 300.0

global		    nrho 1.e20 fnum 1.e7

create_particles    air n 0
Created 10000 particles
  CPU time = 0.00183773 secs
collide             vss air ar.vss

# checks every timestep that each particle is inside the cell it is
# assigned to, which is what the optimized move computes directly

fix                 gcheck grid/check 1 error

stats		    100
stats_style	    step cpu np nattempt ncoll nbound

timestep            1.e-6
run 		    500
