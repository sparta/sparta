# NEGATIVE TEST: compute surf mixture which does not contain every species
# the compute tallies only particles whose species is in its mixture, so
# a body driven by such a compute would feel only part of the gas; the
# fix must reject it

seed	    	    12345
dimension   	    2
boundary            o o p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    10 10 1

global		    nrho 1.0 fnum 0.001

species		    air.species N O
mixture		    air N O vstream 0 0 0 temp 273.0
mixture             sub N vstream 0 0 0 temp 273.0

read_surf           data.square group body
surf_collide	    1 diffuse 300.0 1.0
surf_modify         all collide 1

timestep 	    0.0001

compute             c1 surf body sub fx fy fz tx ty tz com 5 5 0

global              rigid yes

fix		    1 rigid body c1 body &
		    mass 1.0e-22 com 5 5 0 vcom 0 0 0 &
		    moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 angmom 0 0 0

run 		    10
