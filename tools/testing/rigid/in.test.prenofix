# TEST (negative): a fix rigid re-defined between runs, then "run pre no"
# the re-definition replaces the fix, and "pre no" skips the setup
# which initializes it; the fix must refuse to advance an uninitialized
# body instead of using the state of the deleted instance

seed	    	    12345
dimension   	    2
boundary            r r p
create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1
global		    nrho 1.0 fnum 0.001
species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0
read_surf           data.square group body
surf_collide	    1 specular
surf_modify         all collide 1
timestep 	    0.0001
compute             c1 surf body all fx fy fz tx ty tz com 5 5 0
global              rigid yes
fix		    1 rigid body c1 body mass 1.0e-22 com 5 5 0 &
                    vcom 20 5 0 moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 &
                    angmom 0 0 0
stats		    10
stats_style         step
run 		    20
fix		    1 rigid body c1 body mass 1.0e-22 com 5 5 0 &
                    vcom 20 5 0 moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 &
                    angmom 0 0 0
run 		    20 pre no
