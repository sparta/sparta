# TEST: restart continuation, reference run
# a body is driven into a static wall by push-off springs, with no
# particles, so the trajectory is deterministic.  in.test.restart.part1
# and .part2 split the same run in two across a write_restart/read_restart
# and must reproduce this run's final state.
# run as: -var nrun <steps>
seed	    	    12345
variable            nrun index 1500
dimension   	    2
boundary            r r p
create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1
global		    nrho 1.0 fnum 0.001
species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0
read_surf           data.square group body
read_surf           data.wall group wall
read_surf           data.square group body2 trans 0 3 0
surf_collide	    1 specular
surf_modify         all collide 1
timestep 	    0.0001
compute             csurf surf body all fx fy fz tx ty tz com 5 5 0
global              rigid yes
fix		    1 rigid body csurf body mass 1.0e-22 com 5 5 0 &
                    vcom 50 0 0 &
		    moi 8.3333333e-24 8.3333333e-24 1.6666667e-23 0 0 0 &
                    angmom 0 0 0 push 1.0e-18 0.5 pushbound yes
compute             csurf2 surf body2 all fx fy fz tx ty tz com 5 8 0
fix		    2 rigid body2 csurf2 body mass 1.0e-22 com 5 8 0 &
                    vcom -30 0 0 &
		    moi 8.3333333e-24 8.3333333e-24 1.6666667e-23 0 0 0 &
                    angmom 0 0 1.0e-23 push 1.0e-18 0.5 pushbound yes
stats		    ${nrun}
stats_style         step f_1[1] f_1[4] f_1[15] f_2[1] f_2[4] f_2[15]
stats_modify        format float %.17g
run 		    ${nrun}
