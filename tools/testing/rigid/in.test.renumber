# NEGATIVE TEST: body surfs re-numbered after the fix is defined
# with distributed surfs, a remove_surf issued after the fix rigid
# command removes the static wall surfs read before the body and
# re-numbers the body surfs; the fix identifies body elements by
# surf ID and must reject the change

seed	    	    12345
global              surfs explicit/distributed
dimension   	    2
boundary            o o p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    10 10 1

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.wall group wall
read_surf           data.square group body
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001

compute             c1 surf body all fx fy fz tx ty tz com 5 5 0

global              rigid yes

fix		    1 rigid body c1 body &
		    mass 1.0e-22 com 5 5 0 vcom 0 0 0 &
		    moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 angmom 0 0 0

remove_surf         wall

run 		    10
