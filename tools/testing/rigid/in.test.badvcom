# TEST: the vcom keyword is rejected with dstyle = body
# under dstyle = body, vcom is one of the five mandatory keywords inside the
# body block, so accepting it again as an optional keyword would give two
# competing sources for the same value.  it is allowed only with
# dstyle = density, where the body block does not exist.

seed	    	    12345

dimension   	    2
boundary            o o p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    10 10 1

global		    nrho 1.0e10 fnum 1.0e10

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.square group body
surf_collide	    1 specular
surf_modify         all collide 1

compute             c1 surf body all fx fy fz tx ty tz com 5 5 0

global              rigid yes

fix		    1 rigid body c1 body mass 1.0 com 5 5 0 &
                    moi 1.0 1.0 2.0 0 0 0 vcom 0 0 0 angmom 0 0 0 &
                    vcom 1 2 0

run 		    0
