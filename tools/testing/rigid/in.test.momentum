# TEST: gas + body momentum conservation
# fully periodic box, drifting gas, body initially at rest
# total x momentum = m_N * fnum * sum(vx) + M * vcm_x must be conserved
# to statistical noise as the gas pushes the body

# the exactly conserved quantity is not the bare sum of gas and body
# momentum: compute surf tallies the momentum the gas gave up during a
# step, and fix rigid (velocity Verlet) applies half of it at the end
# of that step and half at the start of the next, so a half-step
# impulse 0.5*dt*fcm is in flight at any instant.  Including it gives
# an invariant which holds to round-off rather than to the statistical
# size of one step's transfer.
seed	    	    12345

variable            dist index 0
if "${dist} == 1" then "global surfs explicit/distributed"
dimension   	    2
boundary            p p p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    20 20 1

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 100.0 0 0 temp 273.0

read_surf           data.square group body
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001

compute             c1 surf body all fx fy fz tx ty tz com 5 5 0

global              rigid yes

fix		    1 rigid body c1 body &
		    mass 1.0e-22 com 5 5 0 vcom 0 0 0 &
		    moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 angmom 0 0 0

create_particles    air n 20000

variable px particle vx
compute r reduce sum v_px

stats		    200
stats_style         step np c_r f_1[4] f_1[7] f_1
# full precision: the conserved combination below is exact, so the
# test resolution is set by the printed digits, not by the physics
stats_modify        format float %20.14e
run 		    2000
