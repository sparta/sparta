# TEST: a non-positive density is rejected
# dstyle = density integrates the mass from the geometry, so the density
# itself is the one mass input the user supplies and must be positive.
# it is validated at parse time, before any geometry work is done.

seed	    	    12345
variable            dist index 0
if "${dist} == 1" then "global surfs explicit/distributed"

dimension   	    3
boundary            o o o

create_box  	    -2 2 -2 2 -2 2
create_grid 	    4 4 4

global		    nrho 1.0e10 fnum 1.0e10

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           sdata.cube group body
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    1.0e-6

compute             c1 surf body all fx fy fz tx ty tz com 0 0 0

global              rigid yes

# no mass, com, or moi given: all three are integrated from the geometry

fix		    1 rigid body c1 density -1.0

stats		    1
stats_style         step np nscoll
run 		    1
