# TEST: body near a large static surface, both remap modes
# a gas-driven body starts next to a 200-segment static circle, so
# the incremental re-cut must handle cells holding many static surfs
# with distributed surfs on several procs, most of the static surfs
# are not stored locally on every proc, which exercises the ghost-surf
# handling of the mover and the local copies of body surfs
# remap cutcell and remap incremental must give identical trajectories
# run as: -var mode cutcell   (or incremental)

seed                12345

variable            dist index 0
if "${dist} == 1" then "global surfs explicit/distributed"
dimension           2
global              comm/sort yes

boundary            p p p

create_box          0 10 0 10 -0.5 0.5
create_grid         20 20 1
balance_grid        rcb cell

global              nrho 1.0 fnum 0.001 surfmax 400

species             air.species N
mixture             air N vstream 150.0 40.0 0 temp 273.0

read_surf           data.square group body trans 1.0 -1.5 0
read_surf           data.circle200 group wall
surf_collide        1 specular
surf_modify         all collide 1

timestep            0.0001

compute             c1 surf body all fx fy fz tx ty tz com 6.0 3.5 0

global              rigid yes

fix                 1 rigid body c1 body mass 1.0e-22 com 6.0 3.5 0 &
                    vcom 0 0 0 moi 1.7e-23 1.7e-23 3.4e-23 0 0 0 &
                    angmom 0 0 0 remap ${mode} push 1.0e-18 0.3

create_particles    air n 20000

stats               100
stats_style         step np f_1[1] f_1[2] f_1[15] f_1
stats_modify        format float %20.14e
run                 500
