# TEST: two bodies leave the box through opposite non-periodic faces
# no particles: ballistic motion.  the bodies are plates spanning the
# box in x.  once both bodies are outside the box
# no grid cell overlaps a surf, and the union of the two bodies' bounding
# boxes spans the box in every dimension, so marking the cells as
# INSIDE/OUTSIDE must decide by an exact parity test rather than by
# a bounding box heuristic: all cells are OUTSIDE and the run completes.
# remap cutcell so that the marking is redone on every step

seed	    	    12345
variable            dist index 0
if "${dist} == 1" then "global surfs explicit/distributed"
dimension   	    2
boundary            o o p

create_box  	    0 10 0 10 -0.5 0.5
create_grid 	    10 10 1

global		    nrho 1.0 fnum 0.001

species		    air.species N
mixture		    air N vstream 0 0 0 temp 273.0

read_surf           data.square group body1 origin 5 5 0 scale 10 1 1 trans 0 -2 0
read_surf           data.square group body2 origin 5 5 0 scale 10 1 1 trans 0 2 0
surf_collide	    1 specular
surf_modify         all collide 1

timestep 	    0.0001

compute             c1 surf body1 all fx fy fz tx ty tz com 5 3 0
compute             c2 surf body2 all fx fy fz tx ty tz com 5 7 0

global              rigid yes

fix		    1 rigid body1 c1 body mass 1.0e-22 com 5 3 0 &
                    vcom 0 -400 0 &
		    moi 8.3333333e-24 8.3333333e-24 1.6666667e-23 0 0 0 &
                    angmom 0 0 0 remap cutcell
fix		    2 rigid body2 c2 body mass 1.0e-22 com 5 7 0 &
                    vcom 0 400 0 &
		    moi 8.3333333e-24 8.3333333e-24 1.6666667e-23 0 0 0 &
                    angmom 0 0 0 remap cutcell

stats		    50
stats_style         step f_1[2] f_1[5] f_2[2] f_2[5]
stats_modify        format float %20.14e
run 		    200
